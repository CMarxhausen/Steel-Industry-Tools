#define function for SA516-70
def calculate_steel_plate_weight_sa516(length_in, width_in, height_in):
    inches_to_feet = 1 / 12
    length_ft = length_in * inches_to_feet
    width_ft = width_in * inches_to_feet
    height_ft = height_in * inches_to_feet
    
    volume_cubic_ft = length_ft * width_ft * height_ft
    reference_weight_lb = 40.8384
    reference_length_in = 12
    reference_width_in = 12
    reference_height_in = 1
    
    reference_volume_cubic_ft = (reference_length_in * inches_to_feet) * (reference_width_in * inches_to_feet) * (reference_height_in * inches_to_feet)
    weight_per_cubic_ft = reference_weight_lb / reference_volume_cubic_ft
    plate_weight_lb = weight_per_cubic_ft * volume_cubic_ft
    
    return plate_weight_lb

