def main():
    print("Plate Weight Calculator")
    
    while True:
        while True:  # Loop until a valid choice is made
            print("Select the type of plate:")
            print("1. SA-516-70 Plate")
            print("2. 300 Series Stainless Plate")
            print("3. 400 Series Stainless Plate")
            print("4. SA-357-11 Plate")
        
            choice = input("Enter your choice (1, 2, 3, or 4): ")
        
            if choice in ['1', '2', '3', '4']:
                break  # Exit the loop if a valid choice is made
            else:
                print("Invalid choice. Please enter 1, 2, 3, or 4.")

        try:
            length_in = float(input("\nEnter the length of the plate in inches: "))
            width_in = float(input("Enter the width of the plate in inches: "))
            height_in = float(input("Enter the height of the plate in inches: "))
        
            if choice == '1':
                weight = calculate_steel_plate_weight_sa516(length_in, width_in, height_in)
                material_name = "SA-516-70 Plate"
            elif choice == '2':
                weight = calculate_steel_plate_weight_300_series(length_in, width_in, height_in)
                material_name = "300 Series Stainless Plate"
            elif choice == '3':
                weight = calculate_steel_plate_weight_400_series(length_in, width_in, height_in)
                material_name = "400 Series Stainless Plate"
            elif choice == '4':
                weight = calculate_steel_plate_weight_SA_387_11(length_in, width_in, height_in)
                material_name = "SA-357-11 Plate"
        
            print(f"\nThe weight of the {material_name} is {weight:.2f} pounds.")
    
        except ValueError:
            print("Please enter valid numerical values for the dimensions.")
    
        repeat = input("\nDo you want to calculate the weight of another plate? (y/n)").lower()
        if repeat != 'y':
            print("Goodbye.")
            break

if __name__ == "__main__":
    main()
